DATABASE_URL=postgres://forge:forge@localhost:5433/forgeai

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional server defaults. Signed-in users may instead configure their own
# supported Gemini, Groq, OpenAI, or Anthropic chat provider and key under /settings.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.groq.com/openai/v1

# Gemini Embedding 2 (768 dimensions), used for code indexing and semantic search.
# Per-user Google keys can also be set in /settings; a Gemini chat key can be reused.
EMBEDDING_API_KEY=

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

AI_TPM_LIMIT=8000
AI_OUTPUT_RESERVE_TOKENS=1000
