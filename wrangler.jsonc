{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "changeweft",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-09",
	"compatibility_flags": ["nodejs_compat"],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "3a86f1bd340749bdace3aeb049320b08"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	}
}
